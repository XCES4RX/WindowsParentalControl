<UserControl x:Class="ParentalControl.Admin.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:services="clr-namespace:ParentalControl.Admin.Services">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,16,24,24">

            <!-- ═══ Standard Users Section ═══ -->
            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,14" Margin="0,0,0,16">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EFF6FF" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                            <md:PackIcon Kind="AccountMultiple" Width="18" Height="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding [std_users], Source={x:Static services:LocalizedStrings.Instance}}"
                                   FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding RefreshUsersCommand}"
                            ToolTip="{Binding [tooltip_refresh_users], Source={x:Static services:LocalizedStrings.Instance}}"
                            Width="32" Height="32" HorizontalAlignment="Right">
                        <md:PackIcon Kind="Refresh" Width="18" Height="18" Foreground="#64748B" />
                    </Button>
                </DockPanel>
            </Border>

            <!-- Standard Users Cards -->
            <ItemsControl ItemsSource="{Binding StandardUsers}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="230" Margin="0,0,16,16" Background="#FFFFFF" CornerRadius="14"
                                BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.04" />
                            </Border.Effect>
                            <Button Command="{Binding DataContext.NavigateToUserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalContentAlignment="Stretch"
                                    Height="Auto"
                                    Padding="18,20" Margin="0">
                                <StackPanel HorizontalAlignment="Center">
                                    <!-- Avatar Badge -->
                                    <Border Background="#EEF2FF" CornerRadius="30" Width="60" Height="60"
                                            BorderBrush="#C7D2FE" BorderThickness="1" Margin="0,0,0,12" HorizontalAlignment="Center">
                                        <md:PackIcon Kind="AccountChild" Width="34" Height="34"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="#4F46E5" />
                                    </Border>

                                    <!-- Username -->
                                    <TextBlock Text="{Binding Username}"
                                               FontSize="17" FontWeight="Bold" Foreground="#0F172A"
                                               HorizontalAlignment="Center" TextAlignment="Center" />

                                    <!-- Status Pill -->
                                    <Border CornerRadius="10" Padding="8,2" Margin="0,8,0,8" HorizontalAlignment="Center"
                                            Background="#F1F5F9">
                                        <TextBlock Text="{Binding LimitSummary}"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"
                                                   TextAlignment="Center" />
                                    </Border>

                                    <!-- Schedule & Restrictions -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <md:PackIcon Kind="ClockOutline" Width="13" Height="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding ScheduleSummary}"
                                                   FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <md:PackIcon Kind="ShieldCheckOutline" Width="13" Height="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding RestrictionsSummary}"
                                                   FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══ Administrator Users Section ═══ -->
            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,14" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                            <md:PackIcon Kind="ShieldAccount" Width="18" Height="18" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding [admin_users], Source={x:Static services:LocalizedStrings.Instance}}"
                                   FontSize="15" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding [admin_users_hint], Source={x:Static services:LocalizedStrings.Instance}}"
                               FontSize="12" Foreground="#64748B" Margin="42,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Admin Users Cards -->
            <ItemsControl ItemsSource="{Binding AdminUsers}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="230" Margin="0,0,16,16" Background="#F8FAFC" CornerRadius="14"
                                BorderBrush="#E2E8F0" BorderThickness="1" Opacity="0.75" Padding="18">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="#E2E8F0" CornerRadius="26" Width="52" Height="52" Margin="0,0,0,10" HorizontalAlignment="Center">
                                    <md:PackIcon Kind="AccountTie" Width="30" Height="30" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Username}"
                                           FontSize="15" FontWeight="Bold" Foreground="#334155"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding [admin_role_text], Source={x:Static services:LocalizedStrings.Instance}}"
                                           FontSize="12" Foreground="#94A3B8" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══ Events Section ═══ -->
            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F0FDF4" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                            <md:PackIcon Kind="ClipboardTextClock" Width="18" Height="18" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding [recent_events], Source={x:Static services:LocalizedStrings.Instance}}"
                                   FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding RefreshEventsCommand}"
                            ToolTip="{Binding [tooltip_refresh_events], Source={x:Static services:LocalizedStrings.Instance}}"
                            Width="32" Height="32" HorizontalAlignment="Right">
                        <md:PackIcon Kind="Refresh" Width="18" Height="18" Foreground="#64748B" />
                    </Button>
                </DockPanel>
            </Border>

            <!-- DataGrid inside card -->
            <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8" Margin="0,0,0,16">
                <DataGrid ItemsSource="{Binding EventRecords}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          MaxHeight="380"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          Background="Transparent"
                          BorderThickness="0"
                          PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding [col_timestamp], Source={x:Static services:LocalizedStrings.Instance}}"
                                            Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="160" />
                        <DataGridTextColumn Header="{Binding [col_username], Source={x:Static services:LocalizedStrings.Instance}}"
                                            Binding="{Binding Username}" Width="130" />
                        <DataGridTextColumn Header="{Binding [col_sid], Source={x:Static services:LocalizedStrings.Instance}}"
                                            Binding="{Binding UserSid}" Width="250" />
                        <DataGridTextColumn Header="{Binding [col_event], Source={x:Static services:LocalizedStrings.Instance}}"
                                            Binding="{Binding EventType}" Width="130" />
                        <DataGridTextColumn Header="{Binding [col_details], Source={x:Static services:LocalizedStrings.Instance}}"
                                            Binding="{Binding Details}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
