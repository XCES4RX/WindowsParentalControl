<Window x:Class="ParentalControl.Overlay.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Time Remaining"
        Width="210"
        Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Border x:Name="CardBorder"
            CornerRadius="12"
            Background="#E60F172A"
            BorderBrush="#334155"
            BorderThickness="1"
            Padding="12,7"
            Cursor="Hand"
            ToolTip="Click to open Child Time &amp; Safety Dashboard (Drag to reposition)"
            MouseLeftButtonDown="CardBorder_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0">
                <Ellipse x:Name="StatusDot"
                         Width="7" Height="7"
                         Fill="#10B981"
                         VerticalAlignment="Center"
                         Margin="0,0,5,0" />
                <TextBlock x:Name="UsernameText"
                           DockPanel.Dock="Right"
                           Text="PC"
                           Foreground="#94A3B8"
                           FontSize="9.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="TIME REMAINING"
                           Foreground="#CBD5E1"
                           FontSize="9"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- Big Countdown (Button removed completely) -->
            <DockPanel Grid.Row="1" Margin="0,1,0,0">
                <TextBlock DockPanel.Dock="Right"
                           Text="↗"
                           Foreground="#64748B"
                           FontSize="12"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0" />
                <TextBlock x:Name="CountdownText"
                           Text="--:--:--"
                           Foreground="#38BDF8"
                           FontSize="20"
                           FontWeight="Bold"
                           FontFamily="Consolas, Segoe UI"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- Subtext -->
            <TextBlock x:Name="SubInfoText"
                       Grid.Row="2"
                       Text="Click for details..."
                       Foreground="#94A3B8"
                       FontSize="9"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</Window>