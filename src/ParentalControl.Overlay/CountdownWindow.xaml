<Window x:Class="ParentalControl.Overlay.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Time Remaining"
        Width="226"
        Height="80"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Border x:Name="CardBorder"
            CornerRadius="12"
            Background="#E6161B22"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="12,8"
            Cursor="SizeAll"
            MouseLeftButtonDown="CardBorder_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0">
                <Ellipse x:Name="StatusDot"
                         Width="8" Height="8"
                         Fill="#4ADE80"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0" />
                <TextBlock x:Name="UsernameText"
                           DockPanel.Dock="Right"
                           Text="PC"
                           Foreground="#94A3B8"
                           FontSize="10"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="SESSION TIME LEFT"
                           Foreground="#CBD5E1"
                           FontSize="9.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- Big Countdown + Request Button -->
            <DockPanel Grid.Row="1" Margin="0,2,0,0">
                <Button x:Name="RequestTimeButton"
                        DockPanel.Dock="Right"
                        Content="+15m"
                        ToolTip="Request 15 extra minutes from parent"
                        Click="RequestTimeButton_Click"
                        Height="22"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Background="#2B3344"
                        Foreground="#E2E8F0"
                        BorderBrush="#475569"
                        BorderThickness="1"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Cursor="Hand" />
                <TextBlock x:Name="CountdownText"
                           Text="--:--:--"
                           Foreground="#4ADE80"
                           FontSize="22"
                           FontWeight="Bold"
                           FontFamily="Consolas, Segoe UI"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- Subtext -->
            <TextBlock x:Name="SubInfoText"
                       Grid.Row="2"
                       Text="Connecting..."
                       Foreground="#94A3B8"
                       FontSize="10"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</Window>
