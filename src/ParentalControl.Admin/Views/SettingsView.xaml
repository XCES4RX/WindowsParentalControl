<UserControl x:Class="ParentalControl.Admin.Views.SettingsView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <DockPanel>
        <!-- Back button bar -->
        <Border DockPanel.Dock="Top" Padding="8,4">
            <Button Command="{Binding GoBackCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Back to Dashboard" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,8,16,24" MaxWidth="820" HorizontalAlignment="Left">

                <!-- ═══ Language & Localization ═══ -->
                <md:ColorZone Mode="PrimaryMid" Padding="10,8" CornerRadius="4" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Translate" Width="18" Height="18"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Language &amp; Localization / اللغة والتعريب"
                                   FontSize="14" FontWeight="DemiBold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </md:ColorZone>

                <md:Card Padding="20" Margin="0,0,0,24" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Admin Application Language:" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox SelectedValue="{Binding AppLanguage}"
                                          SelectedValuePath="Tag"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Content="العربية (Arabic)" Tag="ar" />
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="Français (French)" Tag="fr" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Telegram Bot Language:" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox SelectedValue="{Binding TelegramLanguage}"
                                          SelectedValuePath="Tag"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Content="العربية (Arabic)" Tag="ar" />
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="Français (French)" Tag="fr" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Button Content="Save Language Settings"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource MaterialDesignPaperButton}"
                                HorizontalAlignment="Left"
                                Padding="20,8" />
                    </StackPanel>
                </md:Card>

                <!-- ═══ Telegram Bot Integration ═══ -->
                <md:ColorZone Mode="PrimaryMid" Padding="10,8" CornerRadius="4" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Send" Width="18" Height="18"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Telegram Bot Remote Control &amp; Monitoring"
                                   FontSize="14" FontWeight="DemiBold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </md:ColorZone>

                <md:Card Padding="20" Margin="0,0,0,24" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <CheckBox Content="Enable Telegram Bot integration"
                                  IsChecked="{Binding TelegramEnabled}"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,16" />

                        <TextBox md:HintAssist.Hint="Telegram Bot Token or API URL (e.g. 123456:ABC... or https://api.telegram.org/bot...)"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding TelegramBotInput, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     md:HintAssist.Hint="Parent Chat ID (leave empty and send /start to your bot, then click Detect)"
                                     md:HintAssist.IsFloating="True"
                                     Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                            <Button Grid.Column="2"
                                    Content="Detect Chat ID"
                                    Command="{Binding DetectChatIdCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="44" VerticalAlignment="Center" />
                        </Grid>

                        <CheckBox Content="Send instant notification when a user signs in"
                                  IsChecked="{Binding NotifyOnLogin}"
                                  Margin="0,0,0,8" />

                        <CheckBox Content="Send instant notification when a user signs out / logs off"
                                  IsChecked="{Binding NotifyOnLogout}"
                                  Margin="0,0,0,8" />

                        <CheckBox Content="Send instant notification when device shuts down or restarts"
                                  IsChecked="{Binding NotifyOnShutdown}"
                                  Margin="0,0,0,8" />

                        <CheckBox Content="Send alert when daily limit is reached, schedule expires, or clock tampering is detected"
                                  IsChecked="{Binding NotifyOnLimitReached}"
                                  Margin="0,0,0,16" />

                        <TextBlock Text="⚡ Offline Bot Support: Commands sent while the PC is powered off will be queued and automatically executed as soon as the PC boots up."
                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Margin="0,0,0,12" />

                        <TextBlock Text="Supported Telegram commands: /status (device &amp; session status), /screenshot (live screen capture), /limits (manage &amp; edit time), /language (switch language), /update (check updates), /addtime, /settime, /setschedule, /block, /unblock, /policies, /events."
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Test &amp; Connect Bot"
                                    Command="{Binding TestAndSaveCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Padding="20,8" Margin="0,0,12,0" />
                            <Button Content="Save Settings"
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource MaterialDesignPaperButton}"
                                    Padding="20,8" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </md:Card>

                <!-- ═══ Silent Auto-Update ═══ -->
                <md:ColorZone Mode="PrimaryMid" Padding="10,8" CornerRadius="4" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Update" Width="18" Height="18"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Automatic Silent Updates / التحديث التلقائي الصامت"
                                   FontSize="14" FontWeight="DemiBold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </md:ColorZone>

                <md:Card Padding="20" Margin="0,0,0,24" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <CheckBox Content="Enable silent background updates from GitHub Releases"
                                  IsChecked="{Binding AutoUpdateEnabled}"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,8" />

                        <TextBlock Text="Whenever a new version is released on GitHub (XCES4RX/WindowsParentalControl), the background service automatically downloads the installer and applies it silently (/VERYSILENT) without interrupting users."
                                   FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Current Version: " VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentVersion}" VerticalAlignment="Center" Margin="4,0,16,0" />

                            <Button Content="Check for Updates Now"
                                    Command="{Binding CheckUpdateCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="36" Padding="16,4" />
                        </StackPanel>
                    </StackPanel>
                </md:Card>

                <!-- ═══ Child Session Overlay ═══ -->
                <md:ColorZone Mode="PrimaryMid" Padding="10,8" CornerRadius="4" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="TimerOutline" Width="18" Height="18"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Child Session Floating Countdown"
                                   FontSize="14" FontWeight="DemiBold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </md:ColorZone>

                <md:Card Padding="20" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <CheckBox Content="Show floating remaining-time box on the child's desktop"
                                  IsChecked="{Binding ShowCountdownOverlay}"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,8" />
                        <TextBlock Text="Displays a small draggable always-on-top countdown card in the corner of restricted users' screens showing exact time left until the daily limit or allowed schedule ends."
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,16" />
                        <Button Content="Save Overlay Setting"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource MaterialDesignPaperButton}"
                                HorizontalAlignment="Left"
                                Padding="20,8" />
                    </StackPanel>
                </md:Card>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
