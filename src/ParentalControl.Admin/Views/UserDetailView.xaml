<UserControl x:Class="ParentalControl.Admin.Views.UserDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:services="clr-namespace:ParentalControl.Admin.Services">

    <DockPanel>
        <!-- Modern Top Back Bar -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,8">
            <Button Command="{Binding GoBackCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    HorizontalAlignment="Left" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding [btn_back], Source={x:Static services:LocalizedStrings.Instance}}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,24">

                <!-- ═══ User Details Card ═══ -->
                <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#EEF2FF" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                                <md:PackIcon Kind="AccountDetails" Width="18" Height="18" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding [user_details_header], Source={x:Static services:LocalizedStrings.Instance}}"
                                       FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding RefreshUserCommand}"
                                ToolTip="{Binding [tooltip_refresh_users], Source={x:Static services:LocalizedStrings.Instance}}"
                                Width="32" Height="32" HorizontalAlignment="Right">
                            <md:PackIcon Kind="Refresh" Width="18" Height="18" Foreground="#64748B" />
                        </Button>
                    </DockPanel>
                </Border>

                <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Username -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{Binding [lbl_username], Source={x:Static services:LocalizedStrings.Instance}}"
                                   FontSize="11" Foreground="#64748B" FontWeight="Bold" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{Binding User.Username}"
                                   FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0" />

                        <!-- SID -->
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{Binding [lbl_sid], Source={x:Static services:LocalizedStrings.Instance}}"
                                   FontSize="11" Foreground="#64748B" FontWeight="Bold" />
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   Text="{Binding User.Sid}"
                                   FontSize="13" Foreground="#334155" Margin="0,4,0,0" />

                        <!-- Account Type -->
                        <TextBlock Grid.Row="0" Grid.Column="4"
                                   Text="{Binding [lbl_account_type], Source={x:Static services:LocalizedStrings.Instance}}"
                                   FontSize="11" Foreground="#64748B" FontWeight="Bold" />
                        <TextBlock Grid.Row="1" Grid.Column="4"
                                   Text="{Binding User.UserType}"
                                   FontSize="13" Foreground="#334155" Margin="0,4,0,0" />

                        <!-- Restricted -->
                        <TextBlock Grid.Row="0" Grid.Column="6"
                                   Text="{Binding [lbl_restricted], Source={x:Static services:LocalizedStrings.Instance}}"
                                   FontSize="11" Foreground="#64748B" FontWeight="Bold" />
                        <TextBlock Grid.Row="1" Grid.Column="6"
                                   Text="{Binding User.IsRestricted}"
                                   FontSize="13" Foreground="#334155" Margin="0,4,0,0" />

                        <!-- Today's Usage -->
                        <TextBlock Grid.Row="0" Grid.Column="8"
                                   Text="{Binding [lbl_today_usage], Source={x:Static services:LocalizedStrings.Instance}}"
                                   FontSize="11" Foreground="#64748B" FontWeight="Bold" />
                        <StackPanel Grid.Row="1" Grid.Column="8" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBox Text="{Binding EditableUsageMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     Width="65" VerticalAlignment="Center"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Padding="6,3" FontSize="14" />
                            <TextBlock Text="{Binding [unit_minutes], Source={x:Static services:LocalizedStrings.Instance}}"
                                       VerticalAlignment="Center" Margin="6,0,8,0" Foreground="#64748B" />
                            <Button Content="{Binding [btn_set], Source={x:Static services:LocalizedStrings.Instance}}"
                                    Command="{Binding SetUsageCommand}"
                                    Style="{StaticResource MaterialDesignPaperButton}"
                                    Padding="12,2" Height="30" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══ Time Limits Section ═══ -->
                <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EFF6FF" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                            <md:PackIcon Kind="ClockOutline" Width="18" Height="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding [sec_time_limits], Source={x:Static services:LocalizedStrings.Instance}}"
                                   FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     md:HintAssist.Hint="{Binding [lbl_daily_limit], Source={x:Static services:LocalizedStrings.Instance}}"
                                     md:HintAssist.IsFloating="True"
                                     Text="{Binding DailyMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                            <TextBox Grid.Column="2"
                                     md:HintAssist.Hint="{Binding [lbl_sched_start], Source={x:Static services:LocalizedStrings.Instance}}"
                                     md:HintAssist.IsFloating="True"
                                     Text="{Binding ScheduleStart, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                            <TextBox Grid.Column="4"
                                     md:HintAssist.Hint="{Binding [lbl_sched_end], Source={x:Static services:LocalizedStrings.Instance}}"
                                     md:HintAssist.IsFloating="True"
                                     Text="{Binding ScheduleEnd, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding [btn_save_time], Source={x:Static services:LocalizedStrings.Instance}}"
                                    Command="{Binding SetLimitsCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Padding="24,8" Margin="0,0,12,0" />
                            <Button Content="{Binding [btn_remove_app], Source={x:Static services:LocalizedStrings.Instance}}"
                                    Command="{Binding RemoveLimitsCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="#EF4444" BorderBrush="#EF4444"
                                    Padding="24,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ Windows Restrictions Section ═══ -->
                <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FEF3C7" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                            <md:PackIcon Kind="ShieldAlert" Width="18" Height="18" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding [sec_win_restrictions], Source={x:Static services:LocalizedStrings.Instance}}"
                                   FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <CheckBox Content="{Binding [chk_lock_taskbar], Source={x:Static services:LocalizedStrings.Instance}}"
                                  IsChecked="{Binding LockTaskbar}" FontWeight="SemiBold"
                                  Margin="0,0,0,12" />
                        <CheckBox Content="{Binding [chk_block_settings], Source={x:Static services:LocalizedStrings.Instance}}"
                                  IsChecked="{Binding BlockSettings}" FontWeight="SemiBold"
                                  Margin="0,0,0,12" />
                        <CheckBox Content="{Binding [chk_block_taskmgr], Source={x:Static services:LocalizedStrings.Instance}}"
                                  IsChecked="{Binding BlockTaskManager}" FontWeight="SemiBold"
                                  Margin="0,0,0,12" />
                        <CheckBox Content="{Binding [chk_block_cmd], Source={x:Static services:LocalizedStrings.Instance}}"
                                  IsChecked="{Binding BlockCommandPrompt}" FontWeight="SemiBold"
                                  Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding [btn_save_restrictions], Source={x:Static services:LocalizedStrings.Instance}}"
                                    Command="{Binding SavePoliciesCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Padding="24,8" Margin="0,0,12,0" />
                            <Button Content="{Binding [btn_reset_zero], Source={x:Static services:LocalizedStrings.Instance}}"
                                    Command="{Binding ClearPoliciesCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="#EF4444" BorderBrush="#EF4444"
                                    Padding="24,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ Blocked Applications Section ═══ -->
                <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FEE2E2" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                            <md:PackIcon Kind="Cancel" Width="18" Height="18" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding [sec_blocked_apps], Source={x:Static services:LocalizedStrings.Instance}}"
                                   FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBox md:HintAssist.Hint="{Binding [hint_app_name], Source={x:Static services:LocalizedStrings.Instance}}"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding BlockedAppsText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding [btn_add_app], Source={x:Static services:LocalizedStrings.Instance}}"
                                    Command="{Binding SaveBlockedAppsCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Padding="24,8" Margin="0,0,12,0" />
                            <Button Content="{Binding [btn_reset_zero], Source={x:Static services:LocalizedStrings.Instance}}"
                                    Command="{Binding ClearBlockedAppsCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="#EF4444" BorderBrush="#EF4444"
                                    Padding="24,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
