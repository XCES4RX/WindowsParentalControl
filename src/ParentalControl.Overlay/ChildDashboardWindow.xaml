<Window x:Class="ParentalControl.Overlay.ChildDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Child Time &amp; Safety Companion"
        Width="540"
        Height="510"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Border CornerRadius="16"
            Background="#0F172A"
            BorderBrush="#334155"
            BorderThickness="1"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Main Countdown Banner -->
                <RowDefinition Height="Auto" /> <!-- Stats Grid -->
                <RowDefinition Height="Auto" /> <!-- Security & Safeguards -->
                <RowDefinition Height="*" />    <!-- Request Extra Time -->
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Icon & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1.5" Margin="0,0,12,0">
                        <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAppTitle" Text="Child Time &amp; Safety" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtStatus" Text="Active &amp; Protected" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Language Switcher & Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="8" Padding="3" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnLangAr" Content="عربي" Click="BtnLang_Click" Tag="ar" Padding="8,3" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" />
                            <Button x:Name="BtnLangEn" Content="EN" Click="BtnLang_Click" Tag="en" Padding="8,3" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" />
                            <Button x:Name="BtnLangFr" Content="FR" Click="BtnLang_Click" Tag="fr" Padding="8,3" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" />
                        </StackPanel>
                    </Border>
                    <Button Click="BtnClose_Click" Content="✕" Width="28" Height="28" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" FontSize="12" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="7" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Big Countdown Card -->
            <Border Grid.Row="1" CornerRadius="12" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="16,14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtRemainingLabel" Text="TIME LEFT TODAY" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtRemainingTime" Text="--:--:--" Foreground="#38BDF8" FontSize="32" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Margin="0,2,0,0" />
                        <ProgressBar x:Name="BarUsage" Height="6" Value="40" Maximum="100" Background="#0F172A" Foreground="#38BDF8" BorderThickness="0" Margin="0,8,16,0" />
                    </StackPanel>

                    <Border Grid.Column="1" CornerRadius="10" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" Padding="14,10" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtUserBadge" Text="PC" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="TxtUsageRatio" Text="0m / 0m" Foreground="#94A3B8" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Stats Grid -->
            <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,14">
                <!-- Allowed Schedule Card -->
                <Border CornerRadius="10" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="12,10" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtScheduleLabel" Text="Allowed Schedule" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtScheduleValue" Text="08:00 - 22:00" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Current Session Duration Card -->
                <Border CornerRadius="10" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="12,10" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtSessionLabel" Text="Current Session" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtSessionValue" Text="0 min" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Protection Safeguards Status -->
            <Border Grid.Row="3" CornerRadius="10" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="12,10" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock Text="🔒" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtSafeguards" Text="System safeguards and parental restrictions active." Foreground="#CBD5E1" FontSize="11.5" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Request Extra Time Section -->
            <Border Grid.Row="4" CornerRadius="12" Background="#182234" BorderBrush="#2563EB" BorderThickness="1.5" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="TxtRequestTitle" Text="Request Extra Screen Time" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" />
                        <TextBlock x:Name="TxtRequestDesc" Text="Need more time for homework or study? Send a request to your parents via Telegram."
                                   Foreground="#94A3B8" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,10" />
                    </StackPanel>

                    <!-- Buttons Row -->
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,8">
                        <Button x:Name="BtnReq15" Content="+15 Min" Click="BtnRequest_Click" Tag="15" Height="34" Margin="0,0,4,0"
                                Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" FontSize="11.5" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnReq30" Content="+30 Min" Click="BtnRequest_Click" Tag="30" Height="34" Margin="3,0,3,0"
                                Background="#1D4ED8" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" FontSize="11.5" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button x:Name="BtnReq60" Content="+1 Hour" Click="BtnRequest_Click" Tag="60" Height="34" Margin="4,0,0,0"
                                Background="#1E40AF" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" FontSize="11.5" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </UniformGrid>

                    <!-- Feedback notification -->
                    <TextBlock x:Name="TxtFeedback" Grid.Row="2" Text="" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"
                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>