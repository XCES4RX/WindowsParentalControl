<UserControl x:Class="ParentalControl.Admin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:services="clr-namespace:ParentalControl.Admin.Services">

    <DockPanel>
        <!-- Modern Top Back Bar -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,8">
            <Button Command="{Binding GoBackCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    HorizontalAlignment="Left" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding [btn_back], Source={x:Static services:LocalizedStrings.Instance}}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,16,24,32" MaxWidth="880" HorizontalAlignment="Left">

                <!-- ═══ Section 1: Language & Localization ═══ -->
                <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EEF2FF" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                            <md:PackIcon Kind="Translate" Width="18" Height="18" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding [sec_language], Source={x:Static services:LocalizedStrings.Instance}}"
                                   FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- App Language -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [lbl_app_lang], Source={x:Static services:LocalizedStrings.Instance}}"
                                           FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8" />
                                <ComboBox SelectedValue="{Binding AppLanguage}"
                                          SelectedValuePath="Tag"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Content="العربية" Tag="ar" />
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="Français" Tag="fr" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Telegram Bot Language -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [lbl_bot_lang], Source={x:Static services:LocalizedStrings.Instance}}"
                                           FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8" />
                                <ComboBox SelectedValue="{Binding TelegramLanguage}"
                                          SelectedValuePath="Tag"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Content="العربية" Tag="ar" />
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="Français" Tag="fr" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Button Content="{Binding [btn_save_language], Source={x:Static services:LocalizedStrings.Instance}}"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                HorizontalAlignment="Left"
                                Padding="20,8" />
                    </StackPanel>
                </Border>

                <!-- ═══ Section 2: Telegram Bot Integration ═══ -->
                <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EFF6FF" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                            <md:PackIcon Kind="Send" Width="18" Height="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding [sec_telegram], Source={x:Static services:LocalizedStrings.Instance}}"
                                   FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,24">
                    <StackPanel>
                        <CheckBox Content="{Binding [chk_enable_telegram], Source={x:Static services:LocalizedStrings.Instance}}"
                                  IsChecked="{Binding TelegramEnabled}"
                                  FontWeight="Bold" Foreground="#0F172A"
                                  Margin="0,0,0,16" />

                        <TextBox md:HintAssist.Hint="{Binding [hint_bot_token], Source={x:Static services:LocalizedStrings.Instance}}"
                                 md:HintAssist.IsFloating="True"
                                 Text="{Binding TelegramBotInput, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     md:HintAssist.Hint="{Binding [hint_chat_id], Source={x:Static services:LocalizedStrings.Instance}}"
                                     md:HintAssist.IsFloating="True"
                                     Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                            <Button Grid.Column="2"
                                    Content="{Binding [btn_detect_chat], Source={x:Static services:LocalizedStrings.Instance}}"
                                    Command="{Binding DetectChatIdCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="44" VerticalAlignment="Center" />
                        </Grid>

                        <CheckBox Content="{Binding [chk_notify_login], Source={x:Static services:LocalizedStrings.Instance}}"
                                  IsChecked="{Binding NotifyOnLogin}"
                                  Margin="0,0,0,10" />

                        <CheckBox Content="{Binding [chk_notify_logout], Source={x:Static services:LocalizedStrings.Instance}}"
                                  IsChecked="{Binding NotifyOnLogout}"
                                  Margin="0,0,0,10" />

                        <CheckBox Content="{Binding [chk_notify_shutdown], Source={x:Static services:LocalizedStrings.Instance}}"
                                  IsChecked="{Binding NotifyOnShutdown}"
                                  Margin="0,0,0,10" />

                        <CheckBox Content="{Binding [chk_notify_limits], Source={x:Static services:LocalizedStrings.Instance}}"
                                  IsChecked="{Binding NotifyOnLimitReached}"
                                  Margin="0,0,0,16" />

                        <!-- Offline Queue Notice Banner -->
                        <Border Background="#F0FDF4" CornerRadius="10" BorderBrush="#BBF7D0" BorderThickness="1" Padding="14,10" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="LightningBolt" Width="18" Height="18" Foreground="#16A34A" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding [offline_help_text], Source={x:Static services:LocalizedStrings.Instance}}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding [btn_test_connect], Source={x:Static services:LocalizedStrings.Instance}}"
                                    Command="{Binding TestAndSaveCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Padding="20,8" Margin="0,0,12,0" />
                            <Button Content="{Binding [btn_save_settings], Source={x:Static services:LocalizedStrings.Instance}}"
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Padding="20,8" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#2563EB"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- ═══ Section 3: Silent Auto-Update ═══ -->
                <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F0FDF4" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                            <md:PackIcon Kind="Update" Width="18" Height="18" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding [sec_autoupdate], Source={x:Static services:LocalizedStrings.Instance}}"
                                   FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,24">
                    <StackPanel>
                        <CheckBox Content="{Binding [chk_enable_autoupdate], Source={x:Static services:LocalizedStrings.Instance}}"
                                  IsChecked="{Binding AutoUpdateEnabled}"
                                  FontWeight="Bold" Foreground="#0F172A"
                                  Margin="0,0,0,8" />

                        <TextBlock Text="{Binding [autoupdate_description], Source={x:Static services:LocalizedStrings.Instance}}"
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [lbl_current_version], Source={x:Static services:LocalizedStrings.Instance}}"
                                       VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" />
                            <TextBlock Text="{Binding CurrentVersion}" VerticalAlignment="Center" Margin="6,0,18,0" FontWeight="Bold" Foreground="#2563EB" />

                            <Button Content="{Binding [btn_check_updates_now], Source={x:Static services:LocalizedStrings.Instance}}"
                                    Command="{Binding CheckUpdateCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="36" Padding="16,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ Section 4: Child Session Floating Countdown Overlay ═══ -->
                <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FEF3C7" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                            <md:PackIcon Kind="TimerOutline" Width="18" Height="18" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding [sec_overlay], Source={x:Static services:LocalizedStrings.Instance}}"
                                   FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <CheckBox Content="{Binding [chk_show_overlay], Source={x:Static services:LocalizedStrings.Instance}}"
                                  IsChecked="{Binding ShowCountdownOverlay}"
                                  FontWeight="Bold" Foreground="#0F172A"
                                  Margin="0,0,0,8" />

                        <TextBlock Text="{Binding [overlay_description], Source={x:Static services:LocalizedStrings.Instance}}"
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <Button Content="{Binding [btn_save_overlay], Source={x:Static services:LocalizedStrings.Instance}}"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                HorizontalAlignment="Left"
                                Padding="20,8" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
